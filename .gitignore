# Local secrets (PHONE_NUMBER / OTP_CODE etc.) — copy from env.local.example.yaml
config/env.local.yaml

# Test reports (generated at runtime)
reports/

# Maestro debug artifacts
.maestro/

# macOS
.DS_Store

# APK files (too large for git, use GitHub Releases or artifact storage)
*.apk

# Temp files
*.log
*.tmp
*.mp4

# DeviceFarm per-machine config
device-farm/.config/

# DeviceFarm local reports
device-farm/reports/

# DeviceFarm recordings in results
results/**/recordings/
